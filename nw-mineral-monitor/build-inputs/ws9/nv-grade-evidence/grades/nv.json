":"by 1919"}],"mine_id":"nv-starlight-mine","name":"Starlight mine"},{"county":"Pershing","district":"Rochester","evidence":[{"basis":"1920 mill feed","evidence_id":"nv-rochester-silver-corp-1920","measurements":[{"commodity":"Au","unit":"troy_ounces_per_short_ton","value":0.139},{"commodity":"Ag","unit":"troy_ounces_per_short_ton","value":12.63}],"page_cite":"p. 60","page_text_sha256":"56443139fd7ca52f4068b290685cb62ec25c69afe713a29b6746a52b3058cb8c","quote_verbatim":true,"source_id":"usgs-b762","verbatim_quote":"In 1920 the Rochester Silver Corporation milled 42,820 tons of ore, from which $595,351 in bullion was obtained. The ore contained 12.63 ounces of silver and 0.139 ounce of gold to the ton, of which 82.1 per cent of the silver and 91.7 per cent of the gold was won.","years":"1920"}],"mine_id":"nv-rochester-silver-corp","name":"Rochester Silver Corporation mine"},{"county":"Pershing","district":"Rochester","evidence":[{"basis":"1913 ore yielded","evidence_id":"nv-big-four-1913","measurements":[{"commodity":"Ag","unit":"troy_ounces_per_short_ton","value":60}],"page_cite":"p. 60","page_text_sha256":"56443139fd7ca52f4068b290685cb62ec25c69afe713a29b6746a52b3058cb8c","quote_verbatim":true,"source_id":"usgs-b762","verbatim_quote":"During 1913, the first year of large-scale mining, the Big Four lease on the West vein yielded 5,308 tons of ore carrying 60 ounces of silver to the ton","years":"1913"}],"mine_id":"nv-big-four-lease","name":"Big Four lease"},{"county":"Pershing","district":"Rochester","evidence":[{"basis":"early high-grade ore","evidence_id":"nv-codd-early-production","measurements":[{"commodity":"Ag","unit":"troy_ounces_per_short_ton","value":30}],"page_cite":"p. 60","page_text_sha256":"56443139fd7ca52f4068b290685cb62ec25c69afe713a29b6746a52b3058cb8c","quote_verbatim":true,"source_id":"usgs-b762","verbatim_quote":"The Codd lease 9,304 tons of ore carrying 30 ounces to the ton. This high-grade ore was mined above the 300-foot level.","years":"1913"}],"